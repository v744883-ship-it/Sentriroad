# Local dev needs NO override — Vite proxies /api -> :4000 (vite.config.ts).
# For a SPLIT deploy (UI and API on different domains) set this at build time on the host:
#VITE_API_BASE_URL=https://your-api.onrender.com/api/v1
# For the single-service Docker deploy, leave it unset: the app calls /api/v1 on its own origin.
